{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folder",
  "account_id": "<cloudflare-account-id>",
  "main": "./dist/server/index.mjs",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "<kv-namespace-id>"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "<r2-bucket-name>"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/public"
  },
  "routes": [
    {
      "pattern": "<custom-domain>",
      "custom_domain": true
    }
  ],
  "//triggers": "Workers Free allows 5 cron triggers per account; add triggers.crons only if one is free.",
  "triggers": {
    "crons": ["* * * * *"]
  }
}
